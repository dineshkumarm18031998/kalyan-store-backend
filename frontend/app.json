{
  "expo": {
    "name": "Kalyan Store",
    "slug": "kalyan-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kalyanstore",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D84315"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kalyanstore.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D84315"
      },
      "package": "com.kalyanstore.app",
      "versionCode": 1
    },
    "plugins": [
      ["expo-image-picker", {
        "photosPermission": "Allow Kalyan Store to access your photos"
      }]
    ]
  }
}
